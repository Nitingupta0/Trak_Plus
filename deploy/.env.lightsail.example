# TrakPlus — single-VM deployment environment (deploy/.env.lightsail; Lightsail or Azure VM).
# Copy to deploy/.env.lightsail and fill in real values. NEVER commit deploy/.env.lightsail.
# Passed to docker compose with: --env-file deploy/.env.lightsail

# --- Reverse proxy / domain ---
# Bare IP (no scheme) -> plain HTTP. A domain (no scheme) -> Caddy auto-TLS.
# Example: "http://43.204.123.45" or "trak.example.com"
CADDY_SITE_ADDRESS=CHANGE-ME

# --- PostgreSQL (runs in Docker on the box; no RDS) ---
POSTGRES_USER=trakplus
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD
POSTGRES_DB=trakplus

# --- Auth: JWT signing secret (REQUIRED — compose refuses to start without it) ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-RANDOM-HEX

# --- External APIs (from .env) ---
TMDB_API_KEY=CHANGE-ME
RAWG_API_KEY=CHANGE-ME

# --- CORS: JSON array of the origin(s) browsers will use (read by docker-compose.lightsail.yml) ---
# e.g. '["http://43.204.123.45"]' for IP, or '["https://trak.example.com"]'
CORS_ORIGINS=CHANGE-ME

# --- Google OAuth (frontend shows the button only when this is set) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE-ME
# Backend verifies the id_token against this same value.
GOOGLE_CLIENT_ID=CHANGE-ME

# --- Frontend build-time API base (same-origin through Caddy) ---
NEXT_PUBLIC_API_URL=/api
