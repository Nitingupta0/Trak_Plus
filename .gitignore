# --- Environment / secrets (never commit) ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Keep example env tracked
!.env.example

# Lightsail deployment secrets (filled locally)
deploy/.env.lightsail
!deploy/.env.lightsail.example

# --- Terraform (infra/) ---
# NOTE: .terraform.lock.hcl is intentionally NOT committed (skeleton phase).
# Windows-generated lock files contain only windows platform hashes, which
# breaks `terraform init` on the Linux CI runner. CI regenerates a fresh lock
# per run instead. Re-introduce committed locks (via `terraform providers lock`
# for linux+windows) once infra becomes real in Phase 6.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform.tfvars
*.auto.tfvars

# Keep example tfvars tracked
!terraform.tfvars.example

# --- Editors / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Regenerated / derived (next build output, lock files) ---
.next

# --- Logs / temp ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/

# --- Local agent tooling / scratch (per-machine, never shared) ---
# Per-user opencode/agent permissions & settings (contains absolute local paths).
.commandcode/
# One-off debug / exploration scripts with hardcoded local paths.
scratchpad/
# Windows device-name artifact (a file named NUL is not portable across platforms).
/NUL

# --- Graphify (knowledge graph) ---
# Intermediate extraction artifacts at repo root (regenerated by 'graphify .')
.graphify_*
# Local-only graphify state inside graphify-out/ (graphify-out/ itself IS committed)
graphify-out/cost.json
