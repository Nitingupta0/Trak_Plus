# Copy to .env and fill in real values. Never commit .env.

# --- Backend ---
ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://trakplus:trakplus@localhost:5433/trakplus
REDIS_URL=redis://localhost:6379/0

# Auth (self-hosted JWT + Google OAuth — docs/design.md §5b)
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# From https://console.cloud.google.com/apis/credentials (OAuth client ID, type: Web)
GOOGLE_CLIENT_ID=
# Frontend also needs this (browser-side, must match GOOGLE_CLIENT_ID above)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# External APIs (register: https://www.themoviedb.org/settings/api and https://rawg.io/apidocs)
# AniList / Jikan / MangaDex need no key.
TMDB_API_KEY=
RAWG_API_KEY=

# JSON list of allowed frontend origins
CORS_ORIGINS='["http://localhost:3000"]'

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Docker Compose (passed through to containers) ---
# TMDB_API_KEY / RAWG_API_KEY above are used by docker compose interpolation too.
